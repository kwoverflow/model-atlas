OIDC_BROWSER_LOGIN_ENABLED=true
OIDC_JWT_ENABLED=true
OIDC_JWT_ISSUER=http://localhost:18080/realms/model-atlas
OIDC_JWT_AUDIENCE=model-atlas-browser
OIDC_JWT_ALGORITHMS=RS256
OIDC_JWKS_URI=http://keycloak:8080/realms/model-atlas/protocol/openid-connect/certs
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:18080/realms/model-atlas/protocol/openid-connect/auth
OIDC_TOKEN_ENDPOINT=http://keycloak:8080/realms/model-atlas/protocol/openid-connect/token
OIDC_END_SESSION_ENDPOINT=http://localhost:18080/realms/model-atlas/protocol/openid-connect/logout
OIDC_CLIENT_ID=model-atlas-browser
OIDC_REDIRECT_URI=http://localhost:18000/api/v1/operator-identity/callback
OIDC_FRONTEND_URL=http://localhost:3000
OIDC_JWT_ROLE_CLAIM=model_atlas_role
OIDC_JWT_NAME_CLAIM=preferred_username
OIDC_ALLOW_INSECURE_HTTP=true
OIDC_SESSION_SECURE=false
OIDC_SESSION_SECRET=replace-this-local-session-secret-32-chars
OIDC_CSRF_COOKIE_NAME=model_atlas_csrf
OIDC_CSRF_HEADER_NAME=x-model-atlas-csrf
OIDC_SHARED_CACHE_ENABLED=true
OIDC_SESSION_RETENTION_DAYS=30
OIDC_SESSION_CLEANUP_ENABLED=true
OIDC_SESSION_CLEANUP_INTERVAL_SECONDS=3600
OIDC_SESSION_CLEANUP_BATCH_SIZE=200
OPERATIONAL_SNAPSHOT_ENABLED=true
OPERATIONAL_SNAPSHOT_INTERVAL_SECONDS=60
OPERATIONAL_SNAPSHOT_RETENTION_DAYS=30
OPERATIONAL_SLO_WINDOW_SECONDS=3600
OPERATIONAL_SLO_MIN_SAMPLES=3
OPERATIONAL_IDENTITY_SLO_TARGET=0.99
OPERATIONAL_WORKER_SLO_TARGET=0.99
OPERATIONAL_PAGING_ENABLED=false
OPERATIONAL_PAGING_HMAC_SECRET=replace-this-local-paging-secret-32-chars
MODEL_ATLAS_INSTANCE_NAME=backend-1
REJECT_UNTRUSTED_FORWARDED_HEADERS=true
KEYCLOAK_ADMIN_PASSWORD=replace-this-local-admin-password
