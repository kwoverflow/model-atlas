# Local observability profile. Secrets are generated into a runtime-only volume.
OPERATIONAL_PAGING_ENABLED=true
OPERATIONAL_PAGING_WEBHOOK_URL=https://paging-sink:9100/page
OPERATIONAL_PAGING_ALLOWED_HOSTS=paging-sink
OPERATIONAL_PAGING_ALLOW_INSECURE_HTTP=false
OPERATIONAL_PAGING_HMAC_SECRET=
OPERATIONAL_PAGING_HMAC_KEYS_JSON=
OPERATIONAL_PAGING_HMAC_KEYS_FILE=/etc/model-atlas/paging-secrets/hmac-keys.json
OPERATIONAL_PAGING_ACTIVE_KEY_ID=
OPERATIONAL_PAGING_ACTIVE_KEY_ID_FILE=/etc/model-atlas/paging-secrets/active-key-id
OPERATIONAL_PAGING_INITIAL_KEY_ID=development-primary
OPERATIONAL_PAGING_RETIRING_KEY_ID=development-retiring
OPERATIONAL_PAGING_CA_BUNDLE_PATH=/etc/model-atlas/paging-tls/ca.crt
OPERATIONAL_PAGING_PROVIDER=model-atlas-development-sink
OPERATIONAL_PAGING_REQUIRE_RECEIPT=true
OPERATIONAL_PAGING_RECEIPT_MAX_AGE_SECONDS=86400
OPERATIONAL_SLO_SHORT_WINDOW_SECONDS=300
OPERATIONAL_SLO_WARNING_BURN_RATE=6
OPERATIONAL_SLO_CRITICAL_BURN_RATE=14.4
OPERATIONAL_INCIDENT_ESCALATION_SECONDS=900
PROMETHEUS_RETENTION_TIME=30d
